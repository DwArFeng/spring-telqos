<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<xsd:schema
        xmlns="http://dwarfeng.com/schema/spring-telqos"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:tool="http://www.springframework.org/schema/tool"
        targetNamespace="http://dwarfeng.com/schema/spring-telqos"
        elementFormDefault="qualified"
>

    <xsd:import
            namespace="http://www.springframework.org/schema/tool"
            schemaLocation="https://www.springframework.org/schema/tool/spring-tool.xsd"
    />

    <xsd:annotation>
        <xsd:documentation>
            <![CDATA[DwArFeng spring-telqos 项目的命名空间支持。]]></xsd:documentation>
    </xsd:annotation>

    <xsd:element name="config">
        <xsd:annotation>
            <xsd:documentation>
                <![CDATA[通过该元素配置 Telqos 连接与命令相关属性。]]>
            </xsd:documentation>
            <xsd:appinfo>
                <tool:annotation>
                    <tool:exports type="com.dwarfeng.springtelqos.stack.struct.TelqosConfig"/>
                </tool:annotation>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:complexType>
            <xsd:all>
                <xsd:element name="connection-setting" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>
                            <![CDATA[连接设置。]]>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:attribute
                                name="port"
                                type="xsd:string"
                                default="#{T(com.dwarfeng.springtelqos.stack.struct.TelqosConfig$Builder).DEFAULT_PORT}"
                        >
                            <xsd:annotation>
                                <xsd:documentation>
                                    <![CDATA[Telnet 服务开放的端口，默认是 23。]]>
                                </xsd:documentation>
                                <xsd:appinfo>
                                    <tool:annotation>
                                        <tool:expected-type type="java.lang.Integer"/>
                                    </tool:annotation>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute
                                name="whitelist-regex"
                                type="xsd:string"
                                default="#{T(com.dwarfeng.springtelqos.stack.struct.TelqosConfig$Builder).DEFAULT_WHITELIST_REGEX}"
                        >
                            <xsd:annotation>
                                <xsd:documentation>
                                    <![CDATA[连接白名单，默认是空字符串，意味着没有白名单。]]>
                                </xsd:documentation>
                                <xsd:appinfo>
                                    <tool:annotation>
                                        <tool:expected-type type="java.lang.String"/>
                                    </tool:annotation>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute
                                name="blacklist-regex"
                                type="xsd:string"
                                default="#{T(com.dwarfeng.springtelqos.stack.struct.TelqosConfig$Builder).DEFAULT_BLACKLIST_REGEX}"
                        >
                            <xsd:annotation>
                                <xsd:documentation>
                                    <![CDATA[连接黑名单，默认是空字符串，意味着没有黑名单。]]>
                                </xsd:documentation>
                                <xsd:appinfo>
                                    <tool:annotation>
                                        <tool:expected-type type="java.lang.String"/>
                                    </tool:annotation>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute
                                name="charset"
                                type="xsd:string"
                                default="#{T(com.dwarfeng.springtelqos.stack.struct.TelqosConfig$Builder).DEFAULT_CHARSET}"
                        >
                            <xsd:annotation>
                                <xsd:documentation>
                                    <![CDATA[字符集，服务端返回的字符串的字符集，默认是 UTF-8，对于中文 windows 系统，
                                    可能需要把该值改成 GBK。]]>
                                </xsd:documentation>
                                <xsd:appinfo>
                                    <tool:annotation>
                                        <tool:expected-type type="java.lang.String"/>
                                    </tool:annotation>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:attribute>
                        <xsd:attribute
                                name="banner-url"
                                type="xsd:string"
                                default="#{T(com.dwarfeng.springtelqos.stack.struct.TelqosConfig$Builder).DEFAULT_BANNER_URL}"
                        >
                            <xsd:annotation>
                                <xsd:documentation>
                                    <![CDATA[Banner 的地址，新连接接入时向客户端发送的欢迎文本，默认值是该项目自带的字符画，
                                    可以改成其它项目的 banner，或者改成空字符串取消 banner 输出。]]>
                                </xsd:documentation>
                                <xsd:appinfo>
                                    <tool:annotation>
                                        <tool:expected-type type="java.lang.String"/>
                                    </tool:annotation>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:attribute>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="command" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>
                            <![CDATA[命令配置.]]>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="command-impl" minOccurs="0" maxOccurs="unbounded">
                                <xsd:annotation>
                                    <xsd:documentation>
                                        <![CDATA[Command 的实现类.]]>
                                    </xsd:documentation>
                                    <xsd:appinfo>
                                        <tool:exports type="com.dwarfeng.springtelqos.stack.command.Command"/>
                                    </xsd:appinfo>
                                </xsd:annotation>
                                <xsd:complexType>
                                    <xsd:attribute name="id" type="xsd:token">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <![CDATA[Command 的 bean id。]]>
                                            </xsd:documentation>
                                            <xsd:appinfo>
                                                <tool:annotation>
                                                    <tool:expected-type type="java.lang.String"/>
                                                </tool:annotation>
                                            </xsd:appinfo>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                    <xsd:attribute name="class" type="xsd:string">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <![CDATA[Command 的 class 名称，使用该类的无参数构造方法构造对象。]]>
                                            </xsd:documentation>
                                            <xsd:appinfo>
                                                <tool:annotation>
                                                    <tool:expected-type type="java.lang.String"/>
                                                </tool:annotation>
                                            </xsd:appinfo>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                    <xsd:attribute name="ref" type="xsd:string">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <![CDATA[Command 的 bean 引用名称。]]>
                                            </xsd:documentation>
                                            <xsd:appinfo>
                                                <tool:annotation kind="ref">
                                                    <tool:expected-type
                                                            type="com.dwarfeng.springtelqos.stack.command.Command"
                                                    />
                                                </tool:annotation>
                                            </xsd:appinfo>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                    <xsd:attribute name="package-scan" type="xsd:string">
                                        <xsd:annotation>
                                            <xsd:documentation>
                                                <![CDATA[Command 所包的名称。]]>
                                            </xsd:documentation>
                                            <xsd:appinfo>
                                                <tool:annotation>
                                                    <tool:expected-type type="java.lang.String"/>
                                                </tool:annotation>
                                            </xsd:appinfo>
                                        </xsd:annotation>
                                    </xsd:attribute>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="naming-strategy" minOccurs="0">
                    <xsd:annotation>
                        <xsd:documentation>
                            <![CDATA[指令命名设置。]]>
                        </xsd:documentation>
                    </xsd:annotation>
                    <xsd:complexType>
                        <xsd:attribute
                                name="value"
                                type="xsd:string"
                                default="#{T(com.dwarfeng.springtelqos.stack.struct.TelqosConfig$Builder).DEFAULT_COMMAND_NAMING_STRATEGY_CLASS_NAME}"
                        >
                            <xsd:annotation>
                                <xsd:documentation>
                                    <xsd:documentation>
                                        <![CDATA[命名策略接口，未设置时为内置的本征命名策略。]]>
                                    </xsd:documentation>
                                </xsd:documentation>
                                <xsd:appinfo>
                                    <tool:annotation>
                                        <tool:expected-type
                                                type="com.dwarfeng.springtelqos.stack.naming.NamingStrategy"
                                        />
                                    </tool:annotation>
                                </xsd:appinfo>
                            </xsd:annotation>
                        </xsd:attribute>
                    </xsd:complexType>
                </xsd:element>
            </xsd:all>
            <xsd:attribute name="config-id" type="xsd:token" default="telqosConfig">
                <xsd:annotation>
                    <xsd:documentation>
                        <![CDATA[配置的 bean id，默认是 telqosConfig。]]>
                    </xsd:documentation>
                    <xsd:appinfo>
                        <tool:annotation>
                            <tool:expected-type type="java.lang.String"/>
                        </tool:annotation>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:attribute>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="handler">
        <xsd:annotation>
            <xsd:documentation>
                <![CDATA[通过该元素配置 TelqosHandler。]]>
            </xsd:documentation>
            <xsd:appinfo>
                <tool:annotation>
                    <tool:exports type="com.dwarfeng.springtelqos.stack.handler.TelqosHandler"/>
                </tool:annotation>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:complexType>
            <xsd:attribute name="handler-name" type="xsd:token" default="telqosHandlerImpl">
                <xsd:annotation>
                    <xsd:documentation>
                        <![CDATA[Handler 的 bean 名称，默认 telqosHandlerImpl。]]>
                    </xsd:documentation>
                    <xsd:appinfo>
                        <tool:annotation>
                            <tool:expected-type type="java.lang.String"/>
                        </tool:annotation>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:attribute>
            <xsd:attribute name="config-ref" type="xsd:string" default="telqosConfig">
                <xsd:annotation>
                    <xsd:documentation>
                        <![CDATA[TelqosConfig bean 引用，默认 telqosConfig。]]>
                    </xsd:documentation>
                    <xsd:appinfo>
                        <tool:annotation kind="ref">
                            <tool:expected-type type="com.dwarfeng.springtelqos.stack.struct.TelqosConfig"/>
                        </tool:annotation>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:attribute>
            <xsd:attribute name="executor-ref" type="xsd:string" default="executor">
                <xsd:annotation>
                    <xsd:documentation>
                        <![CDATA[ThreadPoolTaskExecutor bean 引用，默认 executor。]]>
                    </xsd:documentation>
                    <xsd:appinfo>
                        <tool:annotation kind="ref">
                            <tool:expected-type
                                    type="org.springframework.scheduling.concurrent.ThreadPoolTaskExecutor"
                            />
                        </tool:annotation>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:attribute>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="qos">
        <xsd:annotation>
            <xsd:documentation>
                <![CDATA[通过该元素配置 TelqosQosService。]]>
            </xsd:documentation>
            <xsd:appinfo>
                <tool:annotation>
                    <tool:exports type="com.dwarfeng.springtelqos.stack.service.TelqosQosService"/>
                </tool:annotation>
            </xsd:appinfo>
        </xsd:annotation>
        <xsd:complexType>
            <xsd:attribute name="service-name" type="xsd:token" default="telqosQosService">
                <xsd:annotation>
                    <xsd:documentation>
                        <![CDATA[TelqosQos 服务的 bean id，默认 telqosQosService。]]>
                    </xsd:documentation>
                    <xsd:appinfo>
                        <tool:annotation>
                            <tool:expected-type type="java.lang.String"/>
                        </tool:annotation>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:attribute>
            <xsd:attribute name="auto-start" type="xsd:string" default="true">
                <xsd:annotation>
                    <xsd:documentation>
                        <![CDATA[是否在容器启动时自动启动 TelqosQos 服务，默认 true。]]>
                    </xsd:documentation>
                    <xsd:appinfo>
                        <tool:annotation>
                            <tool:expected-type type="java.lang.Boolean"/>
                        </tool:annotation>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:attribute>
            <xsd:attribute name="handler-name" type="xsd:token" default="telqosHandlerImpl">
                <xsd:annotation>
                    <xsd:documentation>
                        <![CDATA[TelqosHandler 的 bean 名称，默认 telqosHandlerImpl。]]>
                    </xsd:documentation>
                    <xsd:appinfo>
                        <tool:annotation>
                            <tool:expected-type type="java.lang.String"/>
                        </tool:annotation>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:attribute>
            <xsd:attribute name="sem-ref" type="xsd:string" default="mapServiceExceptionMapper">
                <xsd:annotation>
                    <xsd:documentation>
                        <![CDATA[ServiceExceptionMapper bean 引用，默认 mapServiceExceptionMapper。]]>
                    </xsd:documentation>
                    <xsd:appinfo>
                        <tool:annotation kind="ref">
                            <tool:expected-type type="com.dwarfeng.subgrade.stack.exception.ServiceExceptionMapper"/>
                        </tool:annotation>
                    </xsd:appinfo>
                </xsd:annotation>
            </xsd:attribute>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>
